<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WosuUi"
        xmlns:WosiDomain="clr-namespace:WosiDomain.MongoDocs;assembly=WosiDomain" x:Class="WosuUi.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="346.669" Width="698.75" MinHeight="346.669" MinWidth="698.75" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <CollectionViewSource x:Key="movementViewSource" d:DesignSource="{d:DesignInstance {x:Type WosiDomain:MovementDoc}, CreateList=True}"/>
    <CollectionViewSource x:Key="movementBodyPartMovementsViewSource" Source="{Binding BodyParts, Source={StaticResource movementViewSource}}"/>
    <CollectionViewSource x:Key="movementMovementEquipmentsViewSource" Source="{Binding Equipment, Source={StaticResource movementViewSource}}"/>
  </Window.Resources>
  <Grid DataContext="{StaticResource movementViewSource}" Margin="0,0,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="200"/>
      <ColumnDefinition Width="*" MinWidth="180"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DataGrid x:Name="movementDataGrid" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" RowDetailsVisibilityMode="VisibleWhenSelected" Margin="10,10,8,0" ItemsSource="{Binding}" 
              EnableRowVirtualization="True" AutoGenerateColumns="False" PreparingCellForEdit="movementDataGrid_PreparingCellForEdit" CellEditEnding="movementDataGrid_CellEditEnding"
              SelectionChanged="movementDataGrid_SelectionChanged" SelectedValuePath="Id" SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="nameColumn" Width="Auto" Header="Movement" Binding="{Binding Name}" SortDirection="Ascending"/>
        <DataGridTextColumn x:Name="notesColumn" Width="Auto" Header="Notes" Binding="{Binding Notes}"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Body part entry -->
    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,10,0,0" LastChildFill="True">
      <Label Content="Body Part:" DockPanel.Dock="Left" VerticalContentAlignment="Center" Padding="0,0,5,0"/>
      <TextBox x:Name="BodyPartToAdd" Height="23" TextWrapping="Wrap" Text="TextBox" VerticalContentAlignment="Center"/>
    </DockPanel>
    <Button x:Name="AddBodyPartButton" Grid.Row="0" Grid.Column="2" Content="Add Body Part" Margin="10,10,10,0" Width="120" Height="23"
            VerticalAlignment="Top" Click="AddBodyPartButton_Click"/>

    <DataGrid x:Name="BodyPartMovementsDataGrid" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="False" EnableRowVirtualization="True" 
              ItemsSource="{Binding Source={StaticResource movementBodyPartMovementsViewSource}}" Margin="0,5,0,0" 
              RowDetailsVisibilityMode="VisibleWhenSelected">
      <DataGrid.Columns>
        <!--<DataGridTextColumn x:Name="BodyPartIdColumn" Binding="{Binding BodyPartId}" Header="Body Part Id" Width="SizeToHeader"/>-->
        <DataGridTextColumn x:Name="BodyPartNameColumn" Binding="{Binding Name}" Header="Movement Body Part" Width="SizeToHeader"/>
        <!--<DataGridTextColumn x:Name="MovementIdColumn" Binding="{Binding MovementId}" Header="Movement Id" Width="SizeToHeader"/>-->
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,10,0" Width="120">
      <Label Content="Body Parts" HorizontalAlignment="Center"/>
      <ComboBox x:Name="BodyPartComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding}"/>
      <Button x:Name="AddBodyPartToMovementButton" Margin="0,5,0,0" Height="38" Click="AddBodyPartToMovementButton_Click">
        <TextBlock Text="Add Body Part to Movement" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
    </StackPanel>

    <!-- Equipment entry -->
    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" LastChildFill="True">
      <Label x:Name="label" Content="Equipment:" DockPanel.Dock="Left" VerticalContentAlignment="Center" Padding="0,0,5,0"/>
      <TextBox x:Name="EquipToAdd" Height="23" TextWrapping="Wrap" Text="TextBox" VerticalContentAlignment="Center"/>
    </DockPanel>
    <Button x:Name="AddEquipButton" Grid.Row="2" Grid.Column="2" Content="Add Equipment" Margin="10,10,10,0" Width="120" Height="23"
            VerticalAlignment="Top" Click="AddEquipButton_Click"/>

    <DataGrid x:Name="MovementEquipmentsDataGrid" Grid.Row="3" Grid.Column="1" AutoGenerateColumns="False" EnableRowVirtualization="True" 
              ItemsSource="{Binding Source={StaticResource movementMovementEquipmentsViewSource}}" Margin="0,5,0,0" 
              RowDetailsVisibilityMode="VisibleWhenSelected">
      <DataGrid.Columns>
        <!--<DataGridTextColumn x:Name="equipmentIdColumn" Binding="{Binding EquipmentId}" Header="Equipment Id" Width="SizeToHeader"/>-->
        <DataGridTextColumn x:Name="EquipmentNameColumn" Binding="{Binding Description}" Header="Movement Equipment" Width="SizeToHeader"/>
        <!--<DataGridTextColumn x:Name="movementIdColumn" Binding="{Binding MovementId}" Header="Movement Id" Width="SizeToHeader"/>-->
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Grid.Column="2" Margin="10,0,10,0" Width="120">
      <Label x:Name="label1" Content="Equipment" HorizontalAlignment="Center"/>
      <ComboBox x:Name="EquipmentComboBox" DisplayMemberPath="Description" SelectedValuePath="Id" ItemsSource="{Binding}"/>
      <Button x:Name="AddEquipmentToMovement" Margin="0,5,0,0" Height="35" Click="AddEquipmentToMovement_Click">
        <TextBlock Text="Add Equipment to Movement" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
    </StackPanel>

    <!-- Bottom button bar: left group stays left, right group anchors to the right edge -->
    <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,10,10,10" LastChildFill="False">
      <Button x:Name="NewMovementButton" DockPanel.Dock="Left" Content="Create New Movement" Width="135" Height="23"
              Click="NewMovementButton_Click"/>
      <Button x:Name="FindMovementsByBodyPart" DockPanel.Dock="Left" Content="By Body Part" Margin="5,0,0,0" Width="84" Height="23"
              Click="FindMovementsByBodyPart_Click"/>
      <Button x:Name="GetRandomMovementByBodyPart" DockPanel.Dock="Left" Content="Random By Body Part" Margin="5,0,0,0" Width="124" Height="23"
              Click="GetRandomMovementByBodyPart_Click"/>
      <Button x:Name="BackupDbButton" DockPanel.Dock="Right" Content="Backup DB" Margin="5,0,0,0" Width="75" Height="23"
              Click="BackupDbButton_Click"/>
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Margin="5,0,0,0" Width="41" Height="23"
              Click="SaveButton_Click"/>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Width="54" Height="23"
              Click="RefreshButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
